{
  "name": "ocr-tb",
  "version": "0.1.0",
  "private": true,
  "description": "Offline OCR CLI for short alphanumeric images",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ocr-tb": "bin/ocr-tb.js"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "node scripts/check.js",
    "prepare:assets": "node scripts/prepare-assets.js",
    "doctor": "node bin/ocr-tb.js doctor",
    "benchmark": "node bin/ocr-tb.js evaluate samples/labels.json --output-dir reports/default",
    "lint": "eslint .",
    "benchmark:all": "node scripts/benchmark.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "eslint": "10.13.0"
  }
}
